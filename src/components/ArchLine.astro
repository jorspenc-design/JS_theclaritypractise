    <path d="M33.50 108.20 h31.00 v6.0 h-31.00 Z M36.00 118.40 h26.0 V158.0 h-26.0 Z" vector-effect="non-scaling-stroke" />
    <path d="M135.50 108.20 h31.00 v6.0 h-31.00 Z M138.00 118.40 h26.0 V158.0 h-26.0 Z" vector-effect="non-scaling-stroke" />
  </g>
</svg>
