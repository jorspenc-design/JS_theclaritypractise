---
/** Outline drawing of the keystone arch, for decorative backgrounds. */
interface Props { class?: string; stroke?: string; width?: number; draw?: boolean; brassKey?: boolean }
const { class: className = '', stroke = 'currentColor', width = 1.2, draw = false, brassKey = false } = Astro.props;
---

<svg class={`${className} ${draw ? 'draw-arch' : ''}`} viewBox="28 30 144 132" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <g stroke={stroke} stroke-width={width} vector-effect="non-scaling-stroke" stroke-linejoin="round">
    <path d="M36.00 104.00 A64.0 64.0 0 0 1 41.46 78.14 L64.90 89.43 A38.0 38.0 0 0 0 62.00 104.00 Z" vector-effect="non-scaling-stroke" />
    <path d="M43.28 74.35 A64.0 64.0 0 0 1 58.48 55.30 L74.70 75.65 A38.0 38.0 0 0 0 66.73 85.65 Z" vector-effect="non-scaling-stroke" />
    <path d="M61.76 52.68 A64.0 64.0 0 0 1 83.72 42.11 L89.51 67.48 A38.0 38.0 0 0 0 77.99 73.03 Z" vector-effect="non-scaling-stroke" />
    <path d="M86.92 37.27 L113.08 37.27 L105.73 69.47 L94.27 69.47 Z" stroke={brassKey ? '#B08D57' : stroke} vector-effect="non-scaling-stroke" />
    <path d="M116.28 42.11 A64.0 64.0 0 0 1 138.24 52.68 L122.01 73.03 A38.0 38.0 0 0 0 110.49 67.48 Z" vector-effect="non-scaling-stroke" />
    <path d="M141.52 55.30 A64.0 64.0 0 0 1 156.72 74.35 L133.27 85.65 A38.0 38.0 0 0 0 125.30 75.65 Z" vector-effect="non-scaling-stroke" />
