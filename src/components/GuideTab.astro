---
// GuideTab.astro – Persistent left-side AI guide download tab
---

<div class="guide-wrapper" id="guideWrapper" role="complementary" aria-label="Free AI guide download">

  <!-- Panel (hidden off-screen to the left; slides in when open) -->
  <div class="guide-panel" id="guidePanel" aria-hidden="true">
    <button class="guide-close" id="guideClose" aria-label="Close guide panel">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M11 3L3 11M3 3l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <p class="guide-eyebrow">Free Download</p>
    <h3 class="guide-headline">AI for Pastors &amp; Ministry Leaders</h3>
    <p class="guide-desc">
      A practical starting point for leaders who want to understand AI without getting buried in jargon. No hype — just what matters for your work.
    </p>

    <div class="guide-form-wrap" id="guideFormWrap">
      <form class="guide-form" id="guideForm" novalidate>
        <input
          type="email"
          name="email_address"
          id="guideEmail"
          placeholder="Your email address"
          required
          class="guide-email"
          aria-label="Email address"
          autocomplete="email"
        />
        <button type="submit" class="guide-submit" id="guideSubmit">
          Get the Guide →
        </button>
      </form>
      <p class="guide-fine">No spam. Unsubscribe anytime.</p>
    </div>

    <div class="guide-success" id="guideSuccess" aria-live="polite">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" style="margin: 0 auto;">
        <circle cx="14" cy="14" r="13" stroke="#A07840" stroke-width="1.5"/>
        <path d="M9 14l3.5 3.5L19 10" stroke="#A07840" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <p class="guide-success-msg">Check your inbox — the guide is on its way.</p>
    </div>
  </div>

  <!-- Handle tab (always visible at screen edge) -->
  <button
    class="guide-handle"
    id="guideHandle"
    aria-expanded="false"
    aria-controls="guidePanel"
    aria-label="Open AI guide download"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="guide-handle-icon" aria-hidden="true">
      <path d="M7 1v9M3 7l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="guide-handle-text">Free Guide</span>
  </button>

</div>

<style>
  /* ── Root wrapper: panel width = 296px, so left:-296px hides the panel ── */
  .guide-wrapper {
    position: fixed;
    left: -296px;
    top: 50vh;
    transform: translateY(-50%);
    z-index: 200;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    transition: left 320ms cubic-bezier(0.4, 0, 0.2, 1);
    /* hide on mobile / tablet */
  }

  .guide-wrapper.is-open {
    left: 0;
  }

  /* ── Panel ── */
  .guide-panel {
    width: 296px;
    background: #FDFAF7;
    box-shadow: 4px 0 32px rgba(28, 25, 23, 0.16);
    padding: 32px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    border-right: 1px solid #E8E0D8;
  }

  .guide-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #78716C;
    border-radius: 5px;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 150ms, background 150ms;
  }
  .guide-close:hover { color: #1C1917; background: #F0EAE2; }

  .guide-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #A07840;
    margin-top: 2px;
  }

  .guide-headline {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 17px;
    font-weight: 500;
    color: #1C1917;
    line-height: 1.3;
    text-wrap: balance;
    margin: 0;
  }

  .guide-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #57534E;
    line-height: 1.65;
  }

  /* ── Form ── */
  .guide-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .guide-email {
    width: 100%;
    padding: 9px 13px;
    border: 1.5px solid #DDD5CB;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #1C1917;
    background: #FFF;
    transition: border-color 150ms;
    outline: none;
  }
  .guide-email:focus { border-color: #A07840; }
  .guide-email::placeholder { color: #A8A09A; }

  .guide-submit {
    width: 100%;
    padding: 10px 16px;
    background: #A07840;
    color: #F7F4EE;
    border: none;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms, transform 150ms;
  }
  .guide-submit:hover:not(:disabled) {
    background: #8C6630;
    transform: translateY(-1px);
  }
  .guide-submit:disabled { opacity: 0.75; cursor: default; }

  .guide-fine {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #A8A09A;
    text-align: center;
  }

  /* ── Success state ── */
  .guide-success {
    display: none;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    text-align: center;
    padding: 8px 0 4px;
  }
  .guide-success.show { display: flex; }
  .guide-form-wrap.hide { display: none; }

  .guide-success-msg {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 15px;
    font-weight: 400;
    color: #1C1917;
    line-height: 1.4;
    text-wrap: balance;
    font-style: italic;
  }

  /* ── Handle tab ── */
  .guide-handle {
    width: 36px;
    min-height: 136px;
    background: #A07840;
    color: #F7F4EE;
    border: none;
    border-radius: 0 8px 8px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    cursor: pointer;
    padding: 18px 0;
    transition: background 150ms;
    flex-shrink: 0;
  }
  .guide-handle:hover { background: #8C6630; }

  .guide-handle-text {
    font-family: 'Inter', sans-serif;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .guide-handle-icon {
    flex-shrink: 0;
  }

  /* ── Hide on screens below lg (1024px) ── */
  @media (max-width: 1023px) {
    .guide-wrapper { display: none !important; }
  }
</style>

<script>
const wrapper  = document.getElementById('guideWrapper');
const handle   = document.getElementById('guideHandle');
const closeBtn = document.getElementById('guideClose');
const form     = document.getElementById('guideForm');
const panel    = document.getElementById('guidePanel');
const formWrap = document.getElementById('guideFormWrap');
const success  = document.getElementById('guideSuccess');

if (wrapper && handle) {
  function openPanel() {
    wrapper.classList.add('is-open');
    handle.setAttribute('aria-expanded', 'true');
    panel?.setAttribute('aria-hidden', 'false');
    setTimeout(() => (document.getElementById('guideEmail') as HTMLInputElement | null)?.focus(), 340);
  }

  function closePanel() {
    wrapper.classList.remove('is-open');
    handle.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('aria-hidden', 'true');
  }

  handle.addEventListener('click', () =>
    wrapper.classList.contains('is-open') ? closePanel() : openPanel()
  );

  closeBtn?.addEventListener('click', closePanel);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && wrapper.classList.contains('is-open')) closePanel();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('guideEmail') as HTMLInputElement | null;
    const emailVal = emailInput?.value.trim() ?? '';
    if (!emailVal) return;

    const submitBtn = document.getElementById('guideSubmit') as HTMLButtonElement | null;
    if (submitBtn) { submitBtn.textContent = 'Sending…'; submitBtn.disabled = true; }

    const body = new URLSearchParams({ email_address: emailVal });

    fetch('https://app.kit.com/forms/10167665/subscriptions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
      body: body.toString(),
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then(() => {
        formWrap?.classList.add('hide');
        success?.classList.add('show');
      })
      .catch(() => {
        window.open(
          'https://app.kit.com/forms/10167665/subscriptions?email_address=' + encodeURIComponent(emailVal),
          '_blank', 'noopener',
        );
        formWrap?.classList.add('hide');
        success?.classList.add('show');
      });
  });
}
</script>
