---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-olive text-ivory/70">
  <div class="max-w-6xl mx-auto px-6 pt-16 pb-10 md:pt-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">

      <div class="max-w-sm">
        <Logo tone="dark" size="md" />
        <p class="mt-3 font-sans italic text-sm text-stone/80">A human approach to systems and AI</p>
        <p class="mt-8 text-sm leading-relaxed">
          Helping pastors and ministry leaders build simple systems and use AI wisely, so their time and money go further.
        </p>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-brass font-medium mb-5">Pages</p>
        <nav class="flex flex-col gap-3 text-[15px]" aria-label="Footer">
          <a href="/how-we-work" class="hover:text-ivory transition-colors">How we work</a>
          <a href="/services" class="hover:text-ivory transition-colors">Services and pricing</a>
          <a href="/about" class="hover:text-ivory transition-colors">About</a>
          <a href="/speaking" class="hover:text-ivory transition-colors">Speaking</a>
          <a href="/essays/the-roman-road" class="hover:text-ivory transition-colors">The Roman Road</a>
        </nav>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-brass font-medium mb-5">Contact</p>
        <div class="flex flex-col gap-3 text-[15px]">
          <a href="mailto:joshuaspence@joshuaspence.org" class="hover:text-ivory transition-colors break-all">joshuaspence@joshuaspence.org</a>
          <p>Lexington, Kentucky</p>
          <a href="https://joshuaspence.org" target="_blank" rel="noopener noreferrer" class="text-brass hover:text-ivory transition-colors">
            From the desk of Joshua Spence ↗
          </a>
        </div>
        <a href="/book" class="btn-outline-light mt-8">Book a Clarity Call <span class="btn-arrow">→</span></a>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-ivory/10 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <p class="font-serif text-lg text-ivory">The <span class="text-brass">Clarity</span> Practice</p>
        <span class="mt-1.5 block h-px w-full bg-brass/70"></span>
        <p class="mt-3 text-xs text-ivory/40">The consulting work of Joshua Spence</p>
      </div>
      <p class="text-xs text-ivory/40">© {year} Joshua Spence. All rights reserved.</p>
    </div>
  </div>
</footer>
