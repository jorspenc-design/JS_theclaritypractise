---
const year = new Date().getFullYear();
---

<footer class="bg-charcoal text-ivory/60 mt-0">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="flex flex-col md:flex-row md:justify-between gap-12">

      <!-- Brand column -->
      <div class="max-w-xs">
        <p class="font-serif text-ivory text-xl font-light mb-3">The Clarity Practice</p>
        <p class="text-sm leading-relaxed">
          Helping pastors and ministry leaders build sustainable systems, steward technology wisely, and lead without burning out.
        </p>
        <a
          href="https://joshuaspence.org"
          target="_blank"
          rel="noopener"
          class="inline-block mt-4 text-sm text-brass hover:text-brass/80 transition-colors duration-200"
        >
          From the desk of Joshua Spence ↗
        </a>
      </div>

      <!-- Nav column -->
      <div>
        <p class="text-xs uppercase tracking-widest text-ivory/30 font-medium mb-4">Pages</p>
        <nav class="flex flex-col gap-3">
          <a href="/how-we-work" class="text-sm hover:text-ivory transition-colors duration-200">How We Work</a>
          <a href="/services"    class="text-sm hover:text-ivory transition-colors duration-200">Services &amp; Investment</a>
          <a href="/about"       class="text-sm hover:text-ivory transition-colors duration-200">About</a>
          <a href="/speaking"    class="text-sm hover:text-ivory transition-colors duration-200">Speaking</a>
          <a href="/book"        class="text-sm text-brass hover:text-brass/80 transition-colors duration-200">Book a Clarity Call →</a>
        </nav>
      </div>

      <!-- Contact column -->
      <div>
        <p class="text-xs uppercase tracking-widest text-ivory/30 font-medium mb-4">Contact</p>
        <div class="flex flex-col gap-3">
          <a
            href="mailto:joshuaspence@joshuaspence.org"
            class="text-sm hover:text-ivory transition-colors duration-200"
          >
            joshuaspence@joshuaspence.org
          </a>
          <p class="text-sm">Lexington, Kentucky</p>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-ivory/10 flex flex-col sm:flex-row sm:justify-between gap-2 text-xs text-ivory/30">
      <p>© {year} The Clarity Practice. All rights reserved.</p>
      <p>The consulting work of Joshua Spence.</p>
    </div>
  </div>
</footer>
