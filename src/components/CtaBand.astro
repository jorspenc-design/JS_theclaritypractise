---
import ArchLine from './ArchLine.astro';

interface Props {
  title: string;
  accent?: string;
  body?: string;
  cta?: string;
  href?: string;
}
const {
  title,
  accent,
  body = 'Start with a free 30 minute Clarity Call. No pitch and no pressure, just a conversation about where you are and whether we would be a good fit.',
  cta = 'Book a free Clarity Call',
  href = '/book',
} = Astro.props;
---

<section class="on-dark relative overflow-hidden bg-slate">
  <div class="absolute inset-0 opacity-[0.07] pointer-events-none" style="background-image: radial-gradient(circle at 20% 0%, #F7F3ED 0, transparent 45%), radial-gradient(circle at 90% 100%, #B08D57 0, transparent 40%);" aria-hidden="true"></div>
  <ArchLine class="pointer-events-none absolute left-1/2 -translate-x-1/2 -bottom-40 w-[620px] text-ivory/[0.08]" width={1.2} />
  <div class="relative max-w-3xl mx-auto px-6 py-24 md:py-28 text-center" data-reveal>
    <h2 class="font-serif font-semibold text-ivory text-3xl md:text-5xl leading-[1.1] tracking-[-0.01em]">
      {title}{accent && <> <span class="accent">{accent}</span></>}
    </h2>
    <p class="mt-6 text-lg text-ivory/80 leading-relaxed max-w-[540px] mx-auto">{body}</p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href={href} class="btn-light">{cta} <span class="btn-arrow">→</span></a>
      <slot />
    </div>
  </div>
</section>
