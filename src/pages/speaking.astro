---
import ImageBand from '../components/ImageBand.astro';
import Layout from '../layouts/Layout.astro';
import ArchLine from '../components/ArchLine.astro';
import CtaBand from '../components/CtaBand.astro';

const topics = [
  {
    num:         '01',
    title:       'The Roman Road',
    description: 'Why AI might be the providential infrastructure of our generation, and why that should make us careful rather than excited.',
    format:      '45 to 60 minute keynote',
    bestFor:     'Conferences, denominational gatherings, leadership summits',
  },
  {
    num:         '02',
    title:       'The Quiet Pastor and the Loud Machine',
    description: 'Resisting the formation pressure of AI without rejecting its usefulness. A pastoral approach to adopting technology.',
    format:      '45 minute keynote or 90 minute workshop',
    bestFor:     'Pastor cohorts, staff retreats',
  },
  {
    num:         '03',
    title:       'Stewardship in a Digital Age',
    description: 'Reframing how the local church thinks about new tools, moving from anxiety and fear of missing out toward wisdom and intention.',
    format:      'Keynote or 2-session teaching',
    bestFor:     'Church leadership teams, board retreats',
  },
  {
    num:         '04',
    title:       'Building Systems That Hold',
    description: 'Practical operational wisdom for small ministry teams. How to build infrastructure that grows sustainably without losing the human heart of the work.',
    format:      'Workshop or half-day intensive',
    bestFor:     'Staff trainings, executive team development',
  },
  {
    num:         '05',
    title:       'AI for Ministry Teams: A Working Introduction',
    description: 'A practical, hands-on session for pastors and ministry staff who want to use AI well without being overwhelmed by it.',
    format:      '2 to 3 hour workshop',
    bestFor:     'Church staff trainings, denominational training events',
  },
];
---

<Layout
  title="Speaking"
  description="Bringing clarity to conferences, denominations, leadership retreats, and church teams navigating AI and ministry systems."
>

  <!-- HEADER -->
  <section class="relative overflow-hidden bg-gradient-to-b from-ivory to-[#F1EBE1] border-b border-stone/70">
    <ArchLine class="pointer-events-none absolute -left-24 -bottom-28 w-[420px] text-slate/[0.07]" width={1.4} />
    <div class="relative max-w-6xl mx-auto px-6 pt-20 md:pt-28 pb-16 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] items-center">
      <div>
        <span class="section-label">Speaking</span>
        <h1 class="h-display mt-6 text-5xl md:text-[4.25rem]">Bring clarity to <span class="accent">your gathering.</span></h1>
        <p class="lede mt-7 max-w-[520px]">
          Keynotes and workshops for conferences, denominations, leadership retreats, and church teams working through AI and ministry systems.
        </p>
      </div>
      <div class="relative mx-auto w-full max-w-[340px]">
        <div class="absolute -inset-3 rounded-2xl border border-brass/50 translate-x-4 translate-y-4" aria-hidden="true"></div>
        <img src="/images/js-speaking.jpg" alt="Joshua Spence speaking" class="relative w-full aspect-[4/5] rounded-xl object-cover object-top shadow-[0_24px_50px_-30px_rgba(43,76,111,0.8)]" />
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="bg-paper py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="prose-cap space-y-5 text-lg leading-relaxed text-ink/85" data-reveal>
        <p>
          I speak at gatherings of pastors, ministry leaders, and Christian nonprofit teams, usually on the same handful of questions. How do we steward this technology well? What does faithful growth look like? How do we lead without burning out? Where does AI belong in the life of the church, and where doesn’t it?
        </p>
        <p>
          Sessions can be shaped as keynotes, workshops, multi-session teachings, or staff trainings, whatever serves your gathering best.
        </p>
      </div>
    </div>
  </section>

  <ImageBand
    src="/images/church-audience.jpg"
    position="center 45%"
    eyebrow="The question underneath every talk"
    quote="Where does AI belong in the life of the church, and where doesn’t it?"
  />

  <!-- ── KEYNOTE TOPICS ────────────────────────────────────────────── -->
  <section class="bg-ivory bg-ashlar py-20">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label mb-10" data-reveal>Keynote topics</span>
      <div class="mt-10 space-y-5">
        {topics.map(t => (
          <div class="group card card-lift p-8 md:p-10 border-l-4 border-l-transparent hover:border-l-brass" data-reveal>
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
              <div class="flex-1">
                <span class="font-serif italic text-brass-ink text-sm">{t.num}</span>
                <h2 class="mt-2 text-2xl md:text-[1.75rem] font-serif font-semibold text-slate mb-3">{t.title}</h2>
                <p class="text-ink/85 leading-relaxed">{t.description}</p>
              </div>
              <div class="lg:min-w-[220px] space-y-4 lg:pt-7">
                <div>
                  <p class="text-xs uppercase tracking-[0.14em] text-brass-ink mb-1">Format</p>
                  <p class="text-ink/85 text-sm">{t.format}</p>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-[0.14em] text-brass-ink mb-1">Best for</p>
                  <p class="text-ink/85 text-sm">{t.bestFor}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PAST VENUES ───────────────────────────────────────────────── -->
  <section class="bg-paper py-16 border-t border-stone">
    <div class="max-w-6xl mx-auto px-6">
      <div class="prose-cap">
        <h2 class="text-2xl font-serif font-semibold text-slate mb-4">Past venues</h2>
        <p class="text-ink/85 leading-relaxed italic text-warm-grey">
          A growing list of churches, conferences, and ministries. Coming soon.
        </p>
      </div>
    </div>
  </section>

  <!-- ── INVESTMENT ────────────────────────────────────────────────── -->
  <section class="bg-ivory py-16 border-t border-stone">
    <div class="max-w-6xl mx-auto px-6">
      <div class="prose-cap">
        <h2 class="text-2xl font-serif font-semibold text-slate mb-4">Investment</h2>
        <p class="text-lg text-ink/85 leading-relaxed">
          Speaking starts at $1,500, with a typical range of $1,500 to $3,500, plus travel. Discounts and pro bono dates are available for under-resourced ministries and denominations. Please ask.
        </p>
      </div>
    </div>
  </section>

  <CtaBand title="Bring this to" accent="your gathering." body="Tell me about your event, including the date, audience, format, and budget, and I’ll let you know if we would be a good fit." cta="Inquire about speaking" href="mailto:joshuaspence@joshuaspence.org?subject=Speaking%20inquiry">
    <a href="/book" class="btn-outline-light">Or book a Clarity Call <span class="btn-arrow">→</span></a>
  </CtaBand>

</Layout>
