---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';

// Prices by budget band. An empty string means the item isn't offered at that size.
const plans = [
  {
    name:        'Counsel',
    tagline:     'A steady thinking partner for the lead pastor.',
    prices:      { small: '$600', standard: '$750', established: '$950' },
    includes: [
      'Two phone calls a month to talk things through',
      'Messages between calls in your client portal',
      'A quarterly look at your systems and priorities',
    ],
    term:        'Six month term',
    recommended: false,
  },
  {
    name:        'Steward',
    tagline:     "Hands-on help for a church that's stretched thin.",
    prices:      { small: '$2,000', standard: '$2,500', established: '$3,500' },
    includes: [
      'Two 90 minute working sessions a month',
      'Build work I do between sessions, one system at a time',
      'Your custom AI policy in the first 90 days, plus quarterly staff training and reviews',
    ],
    term:        'Six month minimum. A twelve month term adds every foundation and a new website.',
    recommended: true,
  },
  {
    name:        'Partner',
    tagline:     'Operations leadership for a growing church.',
    prices:      { small: '', standard: '$5,000', established: '$6,500' },
    includes: [
      'A weekly meeting and ownership of your operating rhythm',
      'Staff coaching and help with team structure',
      'Everything in Steward, including your website',
    ],
    term:        'Twelve month term. Limited to a few churches at a time.',
    recommended: false,
  },
];

const addOns = [
  { name: 'Custom AI policy',             note: 'Written for your church, with a training session for your staff', prices: { small: '$1,200',  standard: '$1,500',  established: '$1,500' } },
  { name: 'New church website',           note: 'Built to be found on Google and in AI search tools',              prices: { small: '$2,000',  standard: '$2,500',  established: '$2,500' } },
  { name: 'Website care plan',            note: 'Hosting, updates, and ongoing search upkeep',                      prices: { small: '$150/mo', standard: '$200/mo', established: '$250/mo' } },
  { name: 'Governance Review',            note: 'Checks that your church runs the way your bylaws say it does',     prices: { small: '$950',    standard: '$1,200',  established: '$1,200' } },
  { name: 'Financial Stewardship Review', note: 'Readies your books so outside accounting costs less',              prices: { small: '$1,200',  standard: '$1,500',  established: '$1,500' } },
  { name: 'Both reviews, every quarter',  note: 'Ongoing peace of mind for your board',                             prices: { small: '$300/mo', standard: '$350/mo', established: '$350/mo' } },
  { name: 'Hourly help',                  note: 'Any work that falls outside the above, billed by the half hour. Phone calls are always free.', prices: { small: '$120/hr', standard: '$150/hr', established: '$175/hr' } },
];

const conversationPrices = { small: '$1,000', standard: '$1,250', established: '$1,250' };

const questions = [
  {
    q: 'How do I know which size my church is?',
    a: "Use last year's total operating budget. If you're not sure, pick your best guess and we'll confirm it together on the Clarity Call.",
  },
  {
    q: 'Can we pay for the whole year?',
    a: 'Yes. Pay twelve months up front and save 10%.',
  },
  {
    q: 'Who owns what you build?',
    a: 'Your church does. Your website, domains, accounts, and documents belong to you, always.',
  },
  {
    q: "What if we can't afford this right now?",
    a: "I hold a couple of scholarship spots each quarter at half the usual rate for churches in real need. Just say so when you book a call. There's no shame in asking and no extra forms.",
  },
  {
    q: 'Are the reviews an audit?',
    a: "No. They aren't a CPA audit or legal advice. They prepare your church so that outside help, if you need it, is simpler and less expensive.",
  },
  {
    q: 'Is there a way to learn alongside other churches?',
    a: "Yes. The Clarity Cohort is a free monthly Q&A where pastors and church staff learn alongside other churches. Mention it when you book a call and I'll make sure you're invited.",
  },
  {
    q: 'Do you speak at events?',
    a: 'I do. Keynotes and workshops start at $1,500 plus travel. You can see my topics on the <a href="/speaking" class="text-brass-ink underline underline-offset-4">speaking page</a>.',
  },
];
---

<Layout
  title="Services & Investment"
  description="Every plan and price, published openly. Churches with a budget under $500,000 get 20% off."
>

  <!-- ── HEADER ────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-ivory pt-24 pb-14 md:pt-32">
    <!-- Faded background photo: a small group around a table with coffee and an open Bible -->
    <img
      src="/images/services-table.jpg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center opacity-[0.5] saturate-[0.85]"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ivory/40 via-ivory/55 to-ivory" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-6">
      <span class="section-label">Services and pricing</span>
      <h1 class="mt-4 text-5xl md:text-6xl font-serif font-semibold text-slate leading-[1.04] tracking-[-0.015em]">
        Plans and <span class="accent">pricing.</span>
      </h1>
      <p class="mt-6 text-xl text-ink/85 leading-relaxed max-w-[560px]">
        Every price is on this page. Churches with a budget under $500,000 get 20% off.
      </p>
    </div>
  </section>

  <!-- ── PLANS ─────────────────────────────────────────────────────── -->
  <section class="bg-ivory pb-20">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Church size selector -->
      <p id="church-size-label" class="text-xs uppercase tracking-widest text-warm-grey mb-3">Your church's annual budget</p>
      <div
        role="radiogroup"
        aria-labelledby="church-size-label"
        class="inline-flex flex-wrap rounded-xl border border-stone bg-paper p-1.5 gap-1 shadow-sm"
      >
        <button type="button" role="radio" aria-checked="true" data-band="0"
          class="band-option rounded-md px-4 py-2 text-sm font-medium transition-colors bg-slate text-ivory">
          Under $500K
          <span class="ml-1.5 inline-block rounded-full bg-clay px-2 py-0.5 text-xs font-medium text-ivory align-middle">20% off</span>
        </button>
        <button type="button" role="radio" aria-checked="false" data-band="1"
          class="band-option rounded-md px-4 py-2 text-sm font-medium transition-colors text-ink/85 hover:bg-ivory">
          $500K to $1.5M
        </button>
        <button type="button" role="radio" aria-checked="false" data-band="2"
          class="band-option rounded-md px-4 py-2 text-sm font-medium transition-colors text-ink/85 hover:bg-ivory">
          Over $1.5M
        </button>
      </div>

      <!-- Plan cards -->
      <div class="mt-8 grid gap-6 lg:grid-cols-3 items-stretch">
        {plans.map(p => (
          <div data-reveal class={`relative flex flex-col rounded-2xl p-8 transition-all duration-300 hover:-translate-y-1 ${p.recommended ? 'bg-slate text-ivory shadow-[0_24px_50px_-28px_rgba(43,76,111,0.9)] on-dark' : 'bg-paper border border-stone hover:border-brass/60 hover:shadow-[0_18px_40px_-24px_rgba(43,76,111,0.45)]'}`}>
            <p class="text-xs uppercase tracking-[0.14em] h-4 text-brass">{p.recommended ? 'Recommended' : ''}</p>
            <h2 class={`mt-2 text-3xl font-serif font-semibold ${p.recommended ? 'text-ivory' : 'text-slate'}`}>{p.name}</h2>
            <p class={`mt-2 font-serif italic ${p.recommended ? 'text-ivory/80' : 'text-ink/80'}`}>{p.tagline}</p>

            <div
              class={`mt-6 border-b pb-6 min-h-[84px] ${p.recommended ? 'border-ivory/15' : 'border-stone'}`}
              data-price
              data-small={p.prices.small}
              data-standard={p.prices.standard}
              data-established={p.prices.established}
            >
              <p class={`text-4xl font-serif font-semibold ${p.recommended ? 'text-ivory' : 'text-slate'} ${p.prices.small ? '' : 'hidden'}`} data-amount-row>
                <span data-amount>{p.prices.small || p.prices.standard}</span><span class={`text-sm font-sans font-normal ${p.recommended ? 'text-ivory/60' : 'text-warm-grey'}`}>/mo</span>
              </p>
              <p class={`font-serif text-lg ${p.recommended ? 'text-ivory/80' : 'text-ink/80'} ${p.prices.small ? 'hidden' : ''}`} data-unavailable>For churches over $500K</p>
              <p class={`text-xs mt-1 ${p.recommended ? 'text-ivory/60' : 'text-warm-grey'}`} data-rate-label>{p.prices.small ? 'Small church rate' : 'Not offered at this size'}</p>
            </div>

            <ul class="mt-6 space-y-3 flex-1">
              {p.includes.map(item => (
                <li class={`flex gap-3 leading-relaxed ${p.recommended ? 'text-ivory/85' : 'text-ink/85'}`}>
                  <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brass"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <p class={`mt-6 text-sm ${p.recommended ? 'text-ivory/60' : 'text-warm-grey'}`}>{p.term}</p>

            <a
              href="/book"
              class={p.recommended
                ? 'btn-light mt-6 justify-center !py-3'
                : 'btn-primary mt-6 justify-center'}
            >
              Start with a free call →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HOW IT STARTS ─────────────────────────────────────────────── -->
  <section class="bg-paper py-16">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">How it starts</span>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="card card-lift p-7" data-reveal>
          <span class="font-serif italic text-brass-ink text-sm">01</span>
          <h3 class="mt-2 text-xl font-serif font-semibold text-slate">Free Clarity Call</h3>
          <p class="mt-2 text-ink/85 leading-relaxed">A 30 minute video call about where you are and what you're carrying. No pitch.</p>
        </li>
        <li class="card card-lift p-7" data-reveal>
          <span class="font-serif italic text-brass-ink text-sm">02</span>
          <h3 class="mt-2 text-xl font-serif font-semibold text-slate">
            Clarity Conversation
            <span
              class="ml-1 font-sans text-base text-brass-ink font-medium"
              data-swap
              data-small={conversationPrices.small}
              data-standard={conversationPrices.standard}
              data-established={conversationPrices.established}
            >{conversationPrices.small}</span>
          </h3>
          <p class="mt-2 text-ink/85 leading-relaxed">A 90 minute working session, then a written summary within 48 hours with a clear recommended path.</p>
        </li>
        <li class="card card-lift p-7" data-reveal>
          <span class="font-serif italic text-brass-ink text-sm">03</span>
          <h3 class="mt-2 text-xl font-serif font-semibold text-slate">Choose a plan</h3>
          <p class="mt-2 text-ink/85 leading-relaxed">Begin within 30 days and the full Conversation fee comes off your first month.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── ADD-ONS ───────────────────────────────────────────────────── -->
  <section class="bg-ivory bg-ashlar py-20">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">Built for your church</span>
      <h2 class="mt-4 text-3xl font-serif font-semibold text-slate leading-snug">
        On its own, or inside a plan.
      </h2>

      <div class="mt-8 card divide-y divide-stone overflow-hidden" data-reveal>
        {addOns.map(item => (
          <div class="flex items-start justify-between gap-6 px-6 md:px-8 py-5 transition-colors hover:bg-ivory/70">
            <div>
              <p class="text-slate font-medium">{item.name}</p>
              <p class="text-sm text-ink/85 mt-1">{item.note}</p>
            </div>
            <p
              class="shrink-0 font-serif font-semibold text-lg text-slate"
              data-swap
              data-small={item.prices.small}
              data-standard={item.prices.standard}
              data-established={item.prices.established}
            >{item.prices.small}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── QUESTIONS ─────────────────────────────────────────────────── -->
  <section class="bg-paper py-16">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">Questions</span>
      <div class="mt-8 max-w-[720px] divide-y divide-stone border-y border-stone">
        {questions.map(item => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none [&::-webkit-details-marker]:hidden items-center justify-between gap-4 text-lg font-serif text-slate">
              {item.q}
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-stone text-brass-ink text-xl leading-none transition-all duration-300 group-open:rotate-45 group-open:bg-slate group-open:text-ivory group-open:border-slate">+</span>
            </summary>
            <p class="mt-3 text-ink/85 leading-relaxed" set:html={item.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Every engagement starts" accent="the same way." body="With a free 30 minute conversation about where you are and what you’re working on." />

</Layout>

<script>
  const bands = [
    { key: 'small',       label: 'Small church rate' },
    { key: 'standard',    label: 'Standard rate' },
    { key: 'established', label: 'Established church rate' },
  ];
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.band-option'));
  const selected = ['bg-slate', 'text-ivory'];
  const unselected = ['text-ink/85', 'hover:bg-ivory'];

  function render(index: number) {
    const band = bands[index];

    options.forEach((option, i) => {
      const on = i === index;
      option.setAttribute('aria-checked', String(on));
      option.tabIndex = on ? 0 : -1;
      selected.forEach(c => option.classList.toggle(c, on));
      unselected.forEach(c => option.classList.toggle(c, !on));
    });

    // Plan cards: price, label, or "not offered" note
    document.querySelectorAll<HTMLElement>('[data-price]').forEach(card => {
      const price = card.dataset[band.key] ?? '';
      const available = price !== '';
      card.querySelector('[data-amount-row]')?.classList.toggle('hidden', !available);
      card.querySelector('[data-unavailable]')?.classList.toggle('hidden', available);
      const amount = card.querySelector('[data-amount]');
      if (amount && available) amount.textContent = price;
      const label = card.querySelector('[data-rate-label]');
      if (label) label.textContent = available ? band.label : 'Not offered at this size';
    });

    // Simple prices elsewhere on the page
    document.querySelectorAll<HTMLElement>('[data-swap]').forEach(el => {
      el.textContent = el.dataset[band.key] ?? '';
    });
  }

  options.forEach((option, i) => {
    option.tabIndex = i === 0 ? 0 : -1;
    option.addEventListener('click', () => render(i));
    option.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = (i + (e.key === 'ArrowRight' ? 1 : options.length - 1)) % options.length;
      render(next);
      options[next].focus();
    });
  });
</script>
