---
import Layout from '../layouts/Layout.astro';

const firstSteps = [
  {
    name:  'Clarity Call',
    price: 'Free',
    body:  "A 30 minute video call about where you are and what you're carrying. We'll see together whether working with me makes sense. No pitch.",
  },
  {
    name:  'Clarity Conversation',
    price: '$1,000 small church · $1,250 standard',
    body:  'A 90 minute working session built on my four-phase framework, followed by a written summary within 48 hours that lays out a clear recommended path.',
  },
  {
    name:  'Clarity Circle',
    price: 'Free, monthly',
    body:  "A live teaching and Q&A for pastors and church staff, open to any church. Mention it when you book a call and I'll make sure you're invited.",
  },
];

const plans = [
  {
    name:        'Counsel',
    tagline:     'A steady thinking partner for the lead pastor.',
    small:       '$600',
    standard:    '$750',
    includes: [
      'One session each month, up to 90 minutes',
      'Messages between sessions in your client portal',
      'A quarterly look at your systems and priorities',
    ],
    term:        'Six month term.',
    recommended: false,
  },
  {
    name:        'Steward',
    tagline:     "Hands-on help for a church that's stretched thin.",
    small:       '$2,000',
    standard:    '$2,500',
    includes: [
      'Two 90 minute working sessions a month with you and key staff',
      'Build work I do between sessions, one system at a time',
      'Quarterly AI training for your staff, plus governance and financial reviews',
      'Your custom AI policy in the first 90 days',
    ],
    term:        'Six month minimum. A twelve month term includes every foundation and a new website.',
    recommended: true,
  },
  {
    name:        'Partner',
    tagline:     'Operations leadership for a growing church.',
    small:       null,
    standard:    '$5,000',
    includes: [
      'A weekly meeting and ownership of your operating rhythm',
      'Staff coaching and help with team structure',
      'Everything in Steward, including your website',
    ],
    term:        'Twelve month term. For churches over $500K, and limited to a few at a time.',
    recommended: false,
  },
];

const builds = [
  { name: 'Custom AI policy',             note: 'Written for your church, with a training session for your staff',  small: '$1,200',  standard: '$1,500' },
  { name: 'New church website',           note: 'Built to be found on Google and in AI search tools',               small: '$3,500',  standard: '$4,500' },
  { name: 'Website care plan',            note: 'Hosting, updates, and ongoing search upkeep',                       small: '$150/mo', standard: '$200/mo' },
  { name: 'Governance Review',            note: 'Checks that your church runs the way your bylaws say it does',      small: '$950',    standard: '$1,200' },
  { name: 'Financial Stewardship Review', note: 'Readies your books and finance team so outside accounting costs less', small: '$1,200', standard: '$1,500' },
  { name: 'Both reviews, every quarter',  note: 'Ongoing peace of mind for your board',                              small: '$300/mo', standard: '$350/mo' },
];
---

<Layout
  title="Services & Investment"
  description="Every plan and price, published openly, with a small church rate for churches under $500,000."
>

  <!-- ── PAGE HEADER ───────────────────────────────────────────────── -->
  <section class="bg-ivory pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="prose-cap">
        <span class="section-label mb-4">Offerings</span>
        <h1 class="mt-4 text-5xl md:text-6xl font-serif font-light text-charcoal leading-[1.05] tracking-tight mb-6">
          Services &amp;<br />investment.
        </h1>
        <p class="text-xl text-slate font-light leading-relaxed max-w-[560px]">
          Most of the churches I work with aren't short on vision. They're short on hands. These plans are built to carry some of that weight with you over time.
        </p>
      </div>
    </div>
  </section>

  <!-- ── INTRO ─────────────────────────────────────────────────────── -->
  <section class="bg-white py-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="prose-cap space-y-4 text-lg text-slate leading-relaxed">
        <p>
          Every price is on this page. If you're a pastor trying to figure out whether this fits your budget, you should be able to tell in a minute, not after three calls.
        </p>
        <p>
          Most churches have an annual budget under $500,000, so I keep a small church rate that's about 20% below standard. It isn't a favor or a negotiation. It's how I keep this work within reach of the churches that need it most.
        </p>
      </div>
    </div>
  </section>

  <!-- ── WHERE WE BEGIN ────────────────────────────────────────────── -->
  <section class="bg-ivory py-16">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">Where we begin</span>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {firstSteps.map(s => (
          <div class="border-t border-warm-grey/30 pt-5">
            <h2 class="text-xl font-serif text-charcoal">{s.name}</h2>
            <p class="mt-1 text-brass font-medium text-sm">{s.price}</p>
            <p class="mt-3 text-slate leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-slate leading-relaxed max-w-[640px]">
        If you begin a plan within 30 days of your Clarity Conversation, the full fee comes off your first month.
      </p>
      <div class="mt-6">
        <a href="/book" class="btn-primary">Book a free Clarity Call →</a>
      </div>
    </div>
  </section>

  <!-- ── PLANS ─────────────────────────────────────────────────────── -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">Ongoing plans</span>
      <h2 class="mt-4 text-3xl md:text-4xl font-serif font-light text-charcoal leading-snug max-w-[640px]">
        Help that stays with you, month after month.
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3 items-stretch">
        {plans.map(p => (
          <div class={`flex flex-col rounded-lg p-8 ${p.recommended ? 'border-2 border-brass bg-ivory' : 'border border-warm-grey/20 bg-white'}`}>
            <p class="text-xs uppercase tracking-widest text-brass h-4">{p.recommended ? 'Recommended' : ''}</p>
            <h3 class="mt-2 text-3xl font-serif text-charcoal">{p.name}</h3>
            <p class="mt-2 font-serif italic text-slate">{p.tagline}</p>

            <div class="mt-6 flex gap-8 border-b border-warm-grey/20 pb-6">
              {p.small && (
                <div>
                  <p class="text-3xl font-serif text-charcoal">{p.small}<span class="text-sm font-sans text-warm-grey">/mo</span></p>
                  <p class="text-xs text-warm-grey mt-1">Small church rate</p>
                </div>
              )}
              <div>
                <p class="text-3xl font-serif text-charcoal">{p.standard}<span class="text-sm font-sans text-warm-grey">/mo</span></p>
                <p class="text-xs text-warm-grey mt-1">{p.small ? 'Standard' : 'Starting rate'}</p>
              </div>
            </div>

            <ul class="mt-6 space-y-3 flex-1">
              {p.includes.map(item => (
                <li class="flex gap-3 text-slate leading-relaxed">
                  <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brass"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <p class="mt-6 pt-4 border-t border-warm-grey/20 text-sm text-warm-grey">{p.term}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BUILT FOR YOUR CHURCH ─────────────────────────────────────── -->
  <section class="bg-ivory py-16">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">Built for your church</span>
      <h2 class="mt-4 text-3xl md:text-4xl font-serif font-light text-charcoal leading-snug max-w-[640px]">
        On its own, or inside a plan.
      </h2>

      <div class="mt-10 bg-white border border-warm-grey/20 rounded-lg overflow-hidden">
        <div class="hidden md:grid grid-cols-[1fr_140px_140px] gap-4 px-8 py-4 border-b border-brass/40 text-xs uppercase tracking-widest text-warm-grey">
          <span>What it is</span>
          <span class="text-right">Small church</span>
          <span class="text-right">Standard</span>
        </div>
        {builds.map(b => (
          <div class="grid md:grid-cols-[1fr_140px_140px] gap-1 md:gap-4 px-8 py-5 border-b border-warm-grey/15 last:border-b-0">
            <div>
              <p class="text-charcoal font-medium">{b.name}</p>
              <p class="text-sm text-slate mt-1">{b.note}</p>
            </div>
            <p class="md:text-right text-charcoal font-medium text-sm md:text-base"><span class="md:hidden text-warm-grey font-normal">Small church: </span>{b.small}</p>
            <p class="md:text-right text-charcoal font-medium text-sm md:text-base"><span class="md:hidden text-warm-grey font-normal">Standard: </span>{b.standard}</p>
          </div>
        ))}
      </div>

      <p class="mt-6 text-sm text-warm-grey max-w-[640px] leading-relaxed">
        The reviews aren't a CPA audit or legal advice. They prepare your church so that outside help, if you need it, is simpler and less expensive.
      </p>
    </div>
  </section>

  <!-- ── GOOD TO KNOW ──────────────────────────────────────────────── -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <span class="section-label">Good to know</span>
      <div class="mt-8 grid gap-8 md:grid-cols-2 max-w-[880px]">
        <div>
          <h3 class="text-lg font-serif text-charcoal mb-2">Paying for the year</h3>
          <p class="text-slate leading-relaxed">Pay twelve months up front and save 10%.</p>
        </div>
        <div>
          <h3 class="text-lg font-serif text-charcoal mb-2">Yours to keep</h3>
          <p class="text-slate leading-relaxed">Your website, domains, accounts, and documents belong to your church, always.</p>
        </div>
        <div>
          <h3 class="text-lg font-serif text-charcoal mb-2">Larger churches</h3>
          <p class="text-slate leading-relaxed">If your budget is over $1.5 million, we'll set your rate together on the Clarity Call.</p>
        </div>
        <div>
          <h3 class="text-lg font-serif text-charcoal mb-2">Speaking</h3>
          <p class="text-slate leading-relaxed">Keynotes and workshops start at $1,500 plus travel. <a href="/speaking" class="text-brass underline underline-offset-4">See speaking topics →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SCHOLARSHIP ───────────────────────────────────────────────── -->
  <section class="bg-ivory py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="prose-cap">
        <div class="border-l-4 border-clay pl-7 py-1">
          <h2 class="text-xl font-serif text-charcoal mb-3">When money is tight.</h2>
          <p class="text-slate leading-relaxed">
            I hold a couple of scholarship spots each quarter at half the usual rate for churches in real need. If that's you, just say so when you book a Clarity Call. There's no shame in asking and no extra forms to fill out.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CLOSING CTA ───────────────────────────────────────────────── -->
  <section class="bg-charcoal py-24">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-serif font-light text-ivory leading-snug mb-5">
        Every engagement starts the same way.
      </h2>
      <p class="text-lg text-ivory/70 leading-relaxed mb-10 max-w-[460px] mx-auto">
        With a free 30 minute conversation about where you are and what you're working on.
      </p>
      <a href="/book" class="inline-flex items-center gap-1 px-8 py-4 bg-brass text-ivory font-sans font-medium rounded transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
        Book a free Clarity Call →
      </a>
    </div>
  </section>

</Layout>
