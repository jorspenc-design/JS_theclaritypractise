---
import Layout from '../layouts/Layout.astro';
import ArchMark from '../components/ArchMark.astro';
import ArchLine from '../components/ArchLine.astro';
import CtaBand from '../components/CtaBand.astro';

const phases = [
  { num: '01', title: 'Name the pain',         body: 'Where the friction actually lives, and what used to work but doesn’t anymore.' },
  { num: '02', title: 'Demystify AI',          body: 'The practical face and the ethical face, talked through plainly.' },
  { num: '03', title: 'Ask the big questions', body: 'What faithful growth looks like for your ministry, not the one down the road.' },
  { num: '04', title: 'Lay out the path',      body: 'A concrete, sustainable next step you can take with or without me.' },
];

const audiences = [
  {
    title: 'Churches',
    body:  'Churches of 100 to 500 people that want to grow with wisdom, not just speed.',
    icon:  'M12 3v4M10 5h4M6 21V11l6-4 6 4v10M4 21h16M10 21v-4a2 2 0 0 1 4 0v4',
  },
  {
    title: 'Nonprofits',
    body:  'Small Christian nonprofits with budgets of $250K to $2M, ready to build infrastructure that lasts.',
    icon:  'M4 21V9l8-5 8 5v12M4 21h16M9 21v-6h6v6M8 11h.01M16 11h.01',
  },
  {
    title: 'Leaders',
    body:  'Pastors, executive directors, and founders who want a trusted thought partner instead of another platform to learn.',
    icon:  'M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 21a8 8 0 0 1 16 0',
  },
];
---

<Layout title="Home">

  <!-- HERO -->
  <section class="relative overflow-hidden bg-ivory">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <img
        src="/images/js-hero.png"
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-[70%_15%] md:object-[center_15%]"
        fetchpriority="high"
      />
      <div class="absolute inset-0 md:hidden" style="background: linear-gradient(to bottom, rgba(247,243,237,0.80), rgba(247,243,237,0.96) 55%);"></div>
      <div
        class="absolute inset-0 hidden md:block"
        style="background: linear-gradient(to right, rgba(247,243,237,1) 0%, rgba(247,243,237,1) 28%, rgba(247,243,237,0.75) 40%, rgba(247,243,237,0.08) 54%, rgba(247,243,237,0) 100%);"
      ></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 pt-20 pb-24 md:pt-32 md:pb-36">
      <div class="max-w-[560px]">
        <span class="section-label">The Clarity Practice</span>
        <h1 class="h-display mt-6 text-[2.9rem] md:text-[3.5rem] lg:text-[4rem] max-w-[500px]">
          Helping tired pastors do more with <span class="accent">less.</span>
        </h1>
        <p class="lede mt-7 max-w-[500px]">
          I help pastors and ministry leaders build simple systems and use AI wisely, so their time and money go further and more of their God‑given mission gets done.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-5 items-start sm:items-center">
          <a href="/book" class="btn-primary-lg">Book a free Clarity Call <span class="btn-arrow">→</span></a>
          <a href="/how-we-work" class="btn-ghost">See how I work</a>
        </div>
        <p class="mt-12 flex items-center gap-3 text-sm text-warm-grey">
          <ArchMark class="h-5 w-auto text-slate" />
          <span>A human approach to systems and AI</span>
        </p>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY STRIP -->
  <section class="bg-slate text-ivory">
    <div class="max-w-6xl mx-auto px-6 py-10 grid gap-8 sm:grid-cols-3 sm:divide-x sm:divide-ivory/15">
      {[
        { big: '14+ years', small: 'in business and ministry operations' },
        { big: 'Pastor, COO, CEO', small: 'across churches, nonprofits, and businesses' },
        { big: 'One free call', small: 'to see whether we are a good fit' },
      ].map((s, i) => (
        <div class={`sm:px-8 ${i === 0 ? 'sm:pl-0' : ''}`} data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <p class="font-serif font-semibold text-2xl md:text-[1.7rem] text-ivory">{s.big}</p>
          <p class="mt-1 text-[15px] text-ivory/70">{s.small}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="bg-paper py-24 md:py-28">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20 items-start">
      <div data-reveal>
        <span class="section-label">Where most leaders are</span>
        <h2 class="h-section mt-5">Most pastors I talk to are carrying <span class="accent">too much.</span></h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/85" data-reveal style="--reveal-delay:120ms">
        <p>
          Their volunteers are unclear. Their inbox is heavy. Their tools are scattered across six platforms that don’t talk to each other. AI showed up and made the noise louder, and every conference, podcast, and consultant seems to be selling something that doesn’t quite fit a 200 person church with a part-time admin.
        </p>
        <blockquote class="border-l-2 border-brass pl-6 py-1 font-serif italic text-2xl leading-snug text-slate">
          You’re not behind. You’re under-resourced and over-asked, and that’s a system problem, not a leadership failure.
        </blockquote>
        <p>If that’s the room you’re in, welcome.</p>
      </div>
    </div>
  </section>

  <!-- FRAMEWORK -->
  <section class="bg-ivory py-24 md:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-[640px]" data-reveal>
        <span class="section-label">The Clarity Conversation</span>
        <h2 class="h-section mt-5">Every engagement begins with <span class="accent">four questions.</span></h2>
        <p class="lede mt-6 text-lg">
          A 90 minute working session that is diagnostic, not a pitch. You leave with a clear picture of what’s going on, what AI can and shouldn’t do for you, and what a faithful next step looks like.
        </p>
      </div>

      <div class="relative mt-14">
        <div class="hidden lg:block absolute left-0 right-0 top-[38px] h-px bg-gradient-to-r from-brass/0 via-brass/60 to-brass/0" aria-hidden="true"></div>
        <div class="relative grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {phases.map((p, i) => (
            <div class="card card-lift p-7 pt-6 flex flex-col" data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <span class="inline-flex h-[52px] w-[52px] items-center justify-center rounded-full bg-ivory border border-brass/50 font-serif italic text-xl text-brass-ink">{p.num}</span>
              <h3 class="mt-6 font-serif font-semibold text-xl text-slate leading-snug">{p.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-ink/80">{p.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-10" data-reveal>
        <a href="/how-we-work" class="btn-ghost">Read the full framework <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- WHO -->
  <section class="bg-paper py-24 md:py-28 border-y border-stone/60">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-[640px]" data-reveal>
        <span class="section-label">Who I work with</span>
        <h2 class="h-section mt-5">Built for the church that’s <span class="accent">stretched thin.</span></h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {audiences.map((a, i) => (
          <div class="group card card-lift p-8" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-slate/[0.07] text-slate transition-colors duration-300 group-hover:bg-slate group-hover:text-ivory">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.icon} /></svg>
            </span>
            <h3 class="mt-6 font-serif font-semibold text-2xl text-slate">{a.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/80">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONVICTION -->
  <section class="on-dark relative overflow-hidden bg-slate">
    <ArchLine class="pointer-events-none absolute -right-20 -top-24 w-[420px] text-ivory/[0.06]" width={1.2} />
    <div class="relative max-w-6xl mx-auto px-6 py-24 md:py-28 grid gap-12 md:grid-cols-[1.25fr_1fr] items-center">
      <div data-reveal>
        <span class="section-label">My conviction</span>
        <h2 class="mt-5 font-serif font-semibold text-ivory text-3xl md:text-[2.6rem] leading-[1.15]">
          Christ-centered, <span class="accent">not Christ-branded.</span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-ivory/80 max-w-[540px]">
          The Clarity Practice exists because I believe the local church is worth building well. Every recommendation I make is shaped by historic Christian theology, by years of pastoral work, and by a deep conviction that technology should serve the mission of the church and never the other way around.
        </p>
      </div>
      <div class="relative" data-reveal style="--reveal-delay:150ms">
        <div class="absolute -inset-3 rounded-2xl border border-brass/40 translate-x-4 translate-y-4" aria-hidden="true"></div>
        <img
          src="/images/js-outdoor.jpg"
          alt="Joshua Spence outdoors"
          class="relative rounded-xl w-full aspect-[4/3] object-cover"
          style="object-position:center 25%; filter:saturate(0.85) sepia(0.08);"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ROMAN ROAD -->
  <section class="bg-ivory py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-6 grid gap-14 md:grid-cols-[0.9fr_1.1fr] items-center">
      <div class="flex justify-center" data-reveal>
        <ArchLine draw brassKey class="w-[260px] md:w-[340px] text-slate/70" width={1.6} />
      </div>
      <div data-reveal style="--reveal-delay:150ms">
        <span class="section-label">The founding essay</span>
        <h2 class="h-section mt-5">The Roman <span class="accent">Road.</span></h2>
        <p class="mt-6 font-serif italic text-2xl leading-snug text-slate">
          The Romans did not build those roads for the gospel. But the gospel used them anyway.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-ink/85 max-w-[540px]">
          Every generation receives an infrastructure it did not build. Rome had roads. The Reformation had the printing press. We have AI. The question isn’t whether the church will use it. It’s whether we’ll steward it with wisdom, or be shaped by it without noticing.
        </p>
        <a href="/essays/the-roman-road" class="btn-ghost mt-8">Read the essay <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <CtaBand title="Ready to" accent="begin?" />

</Layout>
