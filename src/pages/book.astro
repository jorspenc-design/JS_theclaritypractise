---
import Layout from '../layouts/Layout.astro';
---

<!-- Single-purpose conversion page: minimal nav -->
<Layout
  title="Book a Clarity Call"
  description="A free 30-minute Clarity Call — no pitch, no pressure. Just a conversation about where you are and whether we'd be a good fit."
  minimalNav={true}
>

  <!-- ── HEADER ────────────────────────────────────────────────────── -->
  <section class="bg-ivory pt-20 pb-12">
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-[600px]">
        <span class="section-label mb-4">Free · 30 Minutes · Video Call</span>
        <h1 class="mt-4 text-5xl md:text-6xl font-serif font-light text-charcoal leading-[1.05] tracking-tight mb-6">
          Let's start with a conversation.
        </h1>
        <p class="text-xl text-slate font-light leading-relaxed">
          A free 30-minute Clarity Call — to talk about where you are, what you're working on, and whether we'd be a good fit to work together. No pitch, no pressure.
        </p>
      </div>
    </div>
  </section>

  <!-- ── 3-STEP EXPLAINER ──────────────────────────────────────────── -->
  <section class="bg-ivory pb-12">
    <div class="max-w-4xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { n: '1', title: 'Pick a time.',            body: 'Use the calendar below to find a slot that works for you.' },
          { n: '2', title: 'Share a little context.', body: 'A few quick questions so I come prepared.' },
          { n: '3', title: 'We talk.',                body: "30 minutes, video call. By the end, you'll have a sense of whether this is the right next step." },
        ].map(step => (
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-brass text-ivory flex items-center justify-center font-sans text-sm font-medium">
              {step.n}
            </span>
            <div>
              <h3 class="font-serif text-lg text-charcoal mb-1">{step.title}</h3>
              <p class="text-slate text-sm leading-relaxed">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CALENDAR EMBED ────────────────────────────────────────────── -->
  <section class="bg-white py-16">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Calendly inline widget -->
      <div
        class="calendly-inline-widget rounded-lg overflow-hidden"
        data-url="https://calendly.com/joshuaspence-joshuaspence/30min?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=a07840"
        style="min-width:320px;height:700px;"
      ></div>

      <p class="mt-6 text-sm text-warm-grey text-center">
        Prefer to email first? Reach out at{' '}
        <a
          href="mailto:joshuaspence@joshuaspence.org"
          class="text-charcoal underline underline-offset-4 decoration-charcoal/30 hover:text-brass hover:decoration-brass transition-colors duration-200"
        >
          joshuaspence@joshuaspence.org
        </a>
      </p>
    </div>
  </section>

  <!-- ── HONEST NOTES ──────────────────────────────────────────────── -->
  <section class="bg-ivory py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-[580px]">
        <h2 class="text-2xl font-serif text-charcoal mb-8">A few honest notes.</h2>
        <div class="space-y-7">
          {[
            {
              title: "It's actually free.",
              body:  "No upsell at the end. If we're a good fit, we'll talk about next steps. If we're not, I'll tell you that — and likely point you to someone better suited.",
            },
            {
              title: "You don't need to be ready.",
              body:  "Most people who book a Clarity Call are still figuring out what they need. That's fine. That's the point.",
            },
            {
              title: "You don't need a budget.",
              body:  "If your ministry is under-resourced, say so. Scholarship slots exist for a reason.",
            },
          ].map(note => (
            <div class="flex gap-4">
              <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-brass"></span>
              <div>
                <h3 class="font-medium text-charcoal mb-1">{note.title}</h3>
                <p class="text-slate leading-relaxed">{note.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</Layout>

<!-- Calendly widget script -->
<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
