---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const steps = [
  { n: '1', title: 'Pick a time.',            body: 'Use the calendar below to find a slot that works for you.' },
  { n: '2', title: 'Share a little context.', body: 'A few quick questions so I come prepared.' },
  { n: '3', title: 'We talk.',                body: 'Thirty minutes on video. By the end, you’ll know whether this is the right next step.' },
];

const notes = [
  {
    title: 'It’s actually free.',
    body:  'No upsell at the end. If we’re a good fit, we’ll talk about next steps. If we’re not, I’ll tell you so, and I’ll likely point you to someone better suited.',
  },
  {
    title: 'You don’t need to be ready.',
    body:  'Most people who book a Clarity Call are still figuring out what they need. That’s fine. That’s the point.',
  },
  {
    title: 'You don’t need a budget.',
    body:  'If your ministry is under-resourced, say so. Scholarship spots exist for a reason.',
  },
];
---

<Layout
  title="Book a Clarity Call"
  description="A free 30 minute Clarity Call. No pitch and no pressure, just a conversation about where you are and whether we would be a good fit."
  minimalNav={true}
>

  <PageHeader
    narrow
    eyebrow="Free · 30 minutes · Video call"
    title="Let’s start with a"
    accent="conversation."
    lede="A free Clarity Call to talk about where you are, what you’re working on, and whether we’d be a good fit to work together. No pitch and no pressure."
  >
    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {steps.map(step => (
        <li class="card p-6 flex gap-4">
          <span class="flex-shrink-0 w-9 h-9 rounded-full bg-slate text-ivory flex items-center justify-center font-serif italic">{step.n}</span>
          <div>
            <h2 class="font-serif font-semibold text-lg text-slate">{step.title}</h2>
            <p class="mt-1 text-[15px] leading-relaxed text-ink/80">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </PageHeader>

  <!-- CALENDAR -->
  <section class="bg-paper py-14 md:py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="card overflow-hidden p-2 md:p-3">
        <div
          class="calendly-inline-widget rounded-lg overflow-hidden"
          data-url="https://calendly.com/joshuaspence-joshuaspence/30min?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=2b4c6f&text_color=2b2b2b"
          style="min-width:300px;height:700px;"
        ></div>
      </div>
      <p class="mt-6 text-[15px] text-warm-grey text-center">
        Prefer to email first? Reach out at
        <a href="mailto:joshuaspence@joshuaspence.org" class="btn-ghost">joshuaspence@joshuaspence.org</a>
      </p>
    </div>
  </section>

  <!-- HONEST NOTES -->
  <section class="bg-ivory py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6">
      <span class="section-label">A few honest notes</span>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {notes.map((note, i) => (
          <div class="card p-7" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <h3 class="font-serif font-semibold text-xl text-slate">{note.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/80">{note.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<!-- Calendly booking widget -->
<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
